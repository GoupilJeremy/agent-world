# 🚫 Agent World - .gitignore
# Fichiers et dossiers à exclure de Git

---

## 📁 Dossiers

# Environnements virtuels Python
venv/
.env/
.venv/
ENV/
env/

# Dossier des dépendances Node.js
frontend/node_modules/
node_modules/

# Dossier des builds
build/
dist/

# Dossier des logs
logs/
*.log

# Dossier des fichiers temporaires
tmp/
.temp/

# Dossier des fichiers générés par les agents
outputs/
agents_output/

# Dossier des données locales (SQLite, etc.)
data/
*.db
*.sqlite

# Dossier des caches
.cache/
__pycache__/
.pytest_cache/
.coverage
htmlcov/

# Dossier des IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# Dossier des OS
.DS_Store
Thumbs.db

# Dossier de Docker
.docker/

# Dossiers de distribution
*.egg-info/

