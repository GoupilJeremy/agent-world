# Secret Template for Agent World Backend
# Version: 0.4.3 (Épic 8 - Sprint 6)
# Description: Secrets sensibles (NE JAMAIS COMMITER CE FICHIER !)
# 
# Pour créer le secret :
#   kubectl create secret generic agent-world-secrets \
#     --from-literal=SECRET_KEY=your-secret-key \
#     --from-literal=POSTGRES_PASSWORD=your-password \
#     --from-literal=MISTRAL_API_KEY=your-mistral-key \
#     --from-literal=OPENAI_API_KEY=your-openai-key \
#     -n agent-world
#
# Ou utiliser sealed-secrets pour plus de sécurité

apiVersion: v1
kind: Secret
metadata:
  name: agent-world-secrets
  namespace: agent-world
  labels:
    app: backend
    component: api
    version: v0.4.3
    epic: "8"
type: Opaque
stringData:
  # Flask Secret Key (générer avec : python -c "import secrets; print(secrets.token_hex(32))")
  SECRET_KEY: "CHANGEZ-MOI-PAR-UNE-VRAIE-CLE-SECRETE-DE-64-CARACTERES"
  
  # PostgreSQL Password
  POSTGRES_PASSWORD: "CHANGEZ-MOI-PAR-UN-MOT-DE-PASSE-FORT"
  
  # AI Model API Keys
  MISTRAL_API_KEY: "votre-cle-api-mistral-ici"
  OPENAI_API_KEY: "votre-cle-api-openai-ici"
  
  # File Cleanup Token (optionnel, pour les endpoints admin)
  FILE_CLEANUP_TOKEN: "token-securise-pour-le-nettoyage"
  
  # Email Configuration (optionnel, pour les notifications)
  EMAIL_API_KEY: "votre-cle-api-email-ici"
  EMAIL_DEFAULT_SENDER: "noreply@agent-world.example.com"
  
  # OAuth Secrets (optionnel, pour les intégrations)
  OAUTH_SECRET: "secret-oauth-pour-les-integrations"
  
  # Redis Password (optionnel, si Redis nécessite une authentification)
  REDIS_PASSWORD: "mot-de-passe-redis-si-configure"

# Notes de sécurité :
# 1. NE JAMAIS commiter ce fichier dans le repository Git
# 2. Utiliser des variables d'environnement ou des secrets managers (Vault, AWS Secrets Manager)
# 3. Pour la production, utiliser sealed-secrets : https://github.com/bitnami-labs/sealed-secrets
# 4. Rotater les secrets régulièrement
# 5. Limiter les permissions (principe du moindre privilège)
