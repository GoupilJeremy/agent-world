# 🌍 Agent World - Environment Configuration
# Version: 0.1.0 (MVP)
# Description: Fichier d'exemple pour les variables d'environnement

# ⚠️ IMPORTANT: Ne jamais committer ce fichier avec des valeurs réelles !
# Copiez ce fichier en .env et modifiez les valeurs selon vos besoins.

---

## 🔐 Application Secrets
# Générez une clé secrète sécurisée pour la production
SECRET_KEY=your-secret-key-here-change-in-production

---

## 🗃️ Database Configuration
# PostgreSQL (recommandé pour la production)
DATABASE_URL=postgresql://user:password@localhost:5432/agent_world

# SQLite (pour le développement)
# DATABASE_URL=sqlite:///agent_world.db

# MongoDB (optionnel)
# MONGO_URI=mongodb://localhost:27017/agent_world

---

## 🤖 AI Model Configuration
# Clés API pour les différents fournisseurs de modèles IA

# Mistral AI
MISTRAL_API_KEY=your-mistral-api-key

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# Groq (pour Llama et Gemma via cloud)
GROQ_API_KEY=your-groq-api-key

# Together AI (alternative pour Llama et Gemma)
TOGETHER_API_KEY=your-together-api-key

# Ollama (modèles locaux)
OLLAMA_BASE_URL=http://localhost:11434

# Modèle par défaut à utiliser
DEFAULT_AI_MODEL=mistral-tiny

# Fallback automatique (Épic 11 - US-074)
AI_FALLBACK_ENABLED=true
AI_FALLBACK_MAX_RETRIES=3
AI_FALLBACK_RETRY_DELAY=1.0

---

## ⚡ Cache Configuration (Redis)
REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TIMEOUT=3600

---

## 🌐 API Configuration
# Origines autorisées pour CORS (séparées par des virgules)
CORS_ORIGINS=*

---

## 📁 File Output Configuration
# Dossier de sortie pour les fichiers générés
OUTPUT_DIR=outputs

---

## 📝 Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT='%(asctime)s - %(name)s - %(levelname)s - %(message)s'

---

## 🏗️ Application Settings
# Environment: development, testing, production
FLASK_ENV=development
FLASK_DEBUG=1

---

## 🌍 Frontend Configuration (si applicable)
# URL de l'API pour le frontend
REACT_APP_API_URL=http://localhost:5000

---

## 🔧 Development Settings
# Port pour le serveur de développement
PORT=5000
HOST=127.0.0.1

---

# 💡 Conseils pour la génération des clés secrètes:
# Python: python -c "import secrets; print(secrets.token_hex(32))"
# Bash: openssl rand -hex 32
